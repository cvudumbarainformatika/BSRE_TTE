# ============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT VARIABLES — BACKEND TTE SERVICE
# Salin file ini menjadi .env dan isi dengan kredensial yang valid
# ============================================================================

ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database Microservice (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/simrs_tte

# Koneksi Database MySQL Riil SIMRS (Hak Akses Read-Only / SELECT Only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rs
DB_USER=viewer
DB_PASSWORD=your_db_password

# Kredensial BSrE BSSN
BSRE_MOCK_MODE=true
BSRE_BASE_URL=https://esign-sandbox.bssn.go.id
BSRE_USERNAME=esign
BSRE_PASSWORD=qwerty
BSRE_TIMEOUT_SECONDS=15
BSRE_DEV_NIK=0803202100007062
BSRE_DEV_PASSPHRASE=Bsre2026.#!

# ClamAV Antivirus
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Profil Resmi Rumah Sakit
HOSPITAL_GOV_HEADER=PEMERINTAH KOTA PROBOLINGGO
HOSPITAL_NAME=UOBK RSUD DOKTER MOHAMAD SALEH
HOSPITAL_CITY=PROBOLINGGO
HOSPITAL_ADDRESS=Jl. Mayjend Panjaitan No.65 Probolinggo Jawa Timur
HOSPITAL_PHONE=Telp. (0335) 433478,433119,421118 Fax. (0335) 432702
